<?xml version="1.0" encoding="utf-8"?>
<!--
   Legacy Auto Backup rules for devices running Android 11 (API 30) and lower.

   The launcher stores user-created workspace data in Room and launcher
   preferences in DataStore. Include only those user-owned files. Specifying
   <include> elements opts out of the default "back up almost everything"
   behaviour, so caches, code caches, no-backup files, and any future
   disposable files are excluded automatically.

   On Android 9+ cloud backups are encrypted with the user's screen-lock
   secret. This legacy format cannot require encryption independently of a
   device-to-device transfer; the Android 12+ policy in data_extraction_rules.xml
   enforces that requirement for cloud backups.
-->
<full-backup-content>
    <!-- Room workspace: pages, items, folders, folder items, and metadata. -->
    <include domain="database" path="." />

    <!-- DataStore preferences under files/datastore/. -->
    <include domain="file" path="datastore/" />

    <!-- Legacy SharedPreferences retained for the DataStore migration. -->
    <include domain="sharedpref" path="." />
</full-backup-content>
