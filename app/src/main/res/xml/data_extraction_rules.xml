<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ (API 31+) data extraction rules.

   Cloud backup and device-to-device transfer include the same user-owned data:
   the Room workspace database, DataStore preferences, and the legacy
   SharedPreferences used by the DataStore migration.

   Cloud backup additionally requires encryption capabilities. If the device
   has no suitable screen lock, cloud backup is skipped; device-to-device
   transfer is unaffected. Cache and no-backup directories are never included.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>

    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
